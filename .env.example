# TMDB API Key (The Movie Database)
# Get your API Read Access Token (Bearer Token) from: https://www.themoviedb.org/settings/api
# Sign up at https://www.themoviedb.org if you don't have an account
VITE_TMDB_API_KEY=your_tmdb_bearer_token_here

# Gemini API Key (for AI features)
# Get your API key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration
# Get these values from Firebase Console: https://console.firebase.google.com/
# 1. Create a new project or select existing one
# 2. Go to Project Settings > General
# 3. Scroll down to "Your apps" section
# 4. Click on the web app icon (</>)
# 5. Copy the configuration values
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id